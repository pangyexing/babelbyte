# BabelByte Configuration

# Twitter API Configuration (TwitterAPI.io)
# Sign up at: https://twitterapi.io  ($0.15 per 1,000 tweets)
TWITTERAPI_IO_KEY=your_twitterapi_io_key_here

# Email Configuration (139邮箱 SMTP)
SMTP_HOST=smtp.139.com
SMTP_PORT=465
SMTP_USER=your_email@139.com
SMTP_PASSWORD=your_smtp_authorization_code
EMAIL_FROM=your_email@139.com
EMAIL_TO=recipient@example.com

# Database
DATABASE_PATH=data/babelbyte.db

# Logging
LOG_LEVEL=INFO
LOG_PATH=logs/babelbyte.log

# Scheduler
# Format: HH:MM (24-hour)
DIGEST_SEND_TIME=08:00
FETCH_INTERVAL_HOURS=6

# AI Provider Configuration
# Provider options: "claude", "codex", "ollama", "auto" (auto-detect)
AI_PROVIDER=auto

# Claude CLI (must be installed and logged in)
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL_HEAVY=sonnet
CLAUDE_MODEL_LIGHT=haiku

# Codex CLI (OpenAI subscription mode, must be installed and logged in)
CODEX_CLI_PATH=codex
CODEX_MODEL_HEAVY=gpt-5.2-codex
CODEX_MODEL_LIGHT=gpt-5.1-codex-mini

# Ollama Configuration (Local LLM)
# Install: https://ollama.com/download
# Pull model: ollama pull qwen3:32b
# Start server: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:32b
OLLAMA_TIMEOUT=120

# Ollama Two-Stage Processing (optional, for better performance)
# When set, uses 8B model for initial screening, then 32B for refinement.
# Expected to save 20-40% processing time while maintaining quality.
# Pull model: ollama pull qwen3:8b
# OLLAMA_MODEL_SCREEN=qwen3:8b

# Model Tier Configuration
# Controls model selection based on content importance
MODEL_TIER_ENABLED=true
MODEL_TIER_HEAVY_THRESHOLD=7
MODEL_TIER_LOW_CONFIDENCE_THRESHOLD=5
MODEL_TIER_CONFIDENCE_CUTOFF=0.5

# Quality Protection
QUALITY_UNKNOWN_DOMAIN_USE_HEAVY=true
QUALITY_REPROCESS_HIGH_SCORE=true
QUALITY_REPROCESS_THRESHOLD=7
QUALITY_RETAIN_KEY_POINTS=true
