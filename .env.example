# BabelByte Configuration

# Twitter API v2 (Free tier: 1,500 tweets/month)
# Apply at: https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Email Configuration (139邮箱 SMTP)
SMTP_HOST=smtp.139.com
SMTP_PORT=465
SMTP_USER=your_email@139.com
SMTP_PASSWORD=your_smtp_authorization_code
EMAIL_FROM=your_email@139.com
EMAIL_TO=recipient@example.com

# Database
DATABASE_PATH=data/babelbyte.db

# Logging
LOG_LEVEL=INFO
LOG_PATH=logs/babelbyte.log

# Scheduler
# Format: HH:MM (24-hour)
DIGEST_SEND_TIME=08:00
FETCH_INTERVAL_HOURS=6

# AI Provider Configuration
# Provider options: "claude", "openai", "auto" (auto-detect)
AI_PROVIDER=auto

# Claude CLI (must be installed and logged in)
CLAUDE_CLI_PATH=claude

# OpenAI API Configuration
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: Custom base URL for OpenAI-compatible APIs (e.g., Azure, local LLMs)
# OPENAI_BASE_URL=https://your-api-endpoint.com/v1
