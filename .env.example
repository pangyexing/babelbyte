# BabelByte Configuration

# Twitter API Configuration (TwitterAPI.io)
# Sign up at: https://twitterapi.io  ($0.15 per 1,000 tweets)
TWITTERAPI_IO_KEY=your_twitterapi_io_key_here

# Email Configuration (139邮箱 SMTP)
SMTP_HOST=smtp.139.com
SMTP_PORT=465
SMTP_USER=your_email@139.com
SMTP_PASSWORD=your_smtp_authorization_code
EMAIL_FROM=your_email@139.com
EMAIL_TO=recipient@example.com

# Database
DATABASE_PATH=data/babelbyte.db

# Logging
LOG_LEVEL=INFO
LOG_PATH=logs/babelbyte.log

# Scheduler
# Format: HH:MM (24-hour)
DIGEST_SEND_TIME=08:00
FETCH_INTERVAL_HOURS=6

# AI Provider Configuration
# Provider options: "claude", "codex", "ollama", "auto" (auto-detect)
AI_PROVIDER=auto

# AI Processing Limit (max items per AI processing run)
AI_PROCESS_LIMIT=500

# Claude CLI (must be installed and logged in)
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL_HEAVY=sonnet
CLAUDE_MODEL_LIGHT=haiku

# Codex CLI (OpenAI subscription mode, must be installed and logged in)
CODEX_CLI_PATH=codex
CODEX_MODEL_HEAVY=gpt-5.2-codex
CODEX_MODEL_LIGHT=gpt-5.1-codex-mini

# Ollama Configuration (Local LLM)
# Install: https://ollama.com/download
# Pull model: ollama pull qwen3:32b
# Start server: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:32b
OLLAMA_TIMEOUT=120

# Ollama Two-Stage Processing (optional, for better performance)
# When set, uses 8B model for initial screening, then 32B for refinement.
# Expected to save 20-40% processing time while maintaining quality.
# Pull model: ollama pull qwen3:8b
# OLLAMA_MODEL_SCREEN=qwen3:8b

# Ollama Concurrent Processing (GPU utilization optimization)
# Enable parallel processing to better utilize GPU during I/O wait times.
# For RTX 4090 (24GB VRAM): workers_heavy=2, workers_screen=4 recommended.
# Disable if experiencing GPU memory issues.
OLLAMA_CONCURRENT_ENABLED=true
OLLAMA_WORKERS_HEAVY=2     # Parallel requests for 32B model (4090: 2 recommended)
OLLAMA_WORKERS_SCREEN=4    # Parallel requests for 8B model (4090: 4 recommended)
OLLAMA_KEEP_ALIVE=1800     # Keep model loaded for 30 minutes (seconds)

# IMPORTANT: Ollama server also needs parallel processing enabled!
# Set this BEFORE starting ollama serve:
#   export OLLAMA_NUM_PARALLEL=2  # Match OLLAMA_WORKERS_HEAVY
#   ollama serve
# Or for systemd: sudo systemctl edit ollama
#   [Service]
#   Environment="OLLAMA_NUM_PARALLEL=2"

# Ollama Thinking Mode (for qwen3 models)
# Controls whether 32B/HEAVY tasks use qwen3's "thinking mode" for reasoning.
# true:  Enable thinking (slower ~43s/item, uses internal reasoning)
# false: Disable thinking (faster ~18s/item, same output quality)
OLLAMA_THINKING_ENABLED=false

# Model Tier Configuration
# Controls model selection based on content importance
MODEL_TIER_ENABLED=true
MODEL_TIER_HEAVY_THRESHOLD=7
MODEL_TIER_LOW_CONFIDENCE_THRESHOLD=5
MODEL_TIER_CONFIDENCE_CUTOFF=0.5

# Quality Protection
QUALITY_UNKNOWN_DOMAIN_USE_HEAVY=true
QUALITY_REPROCESS_HIGH_SCORE=true
QUALITY_REPROCESS_THRESHOLD=7
QUALITY_RETAIN_KEY_POINTS=true

# AI Image Generation (direct diffusers pipeline)
# Generates unique AI backgrounds for video slides.
# Runs directly on host GPU via diffusers — no Docker required.
# Requires: pip install diffusers transformers accelerate
# Model weights auto-downloaded from HuggingFace (~8GB, first run only).
# BF16 uses ~13GB VRAM; auto_release frees GPU after generation for Ollama.
IMAGE_GEN_ENABLED=false
IMAGE_GEN_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
IMAGE_GEN_STEPS=4
IMAGE_GEN_TIMEOUT=120
IMAGE_GEN_AUTO_RELEASE=true

# TTS Provider Configuration
# Provider: "edge" (free, Microsoft network) or "qwen" (local GPU, Qwen3-TTS)
# Qwen3-TTS: ~5-7GB VRAM, higher quality Chinese speech, custom voices
# Requires: pip install qwen-tts soundfile
TTS_PROVIDER=edge
QWEN_TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# Speaker: 预置声音 (vivian/serena/uncle_fu/dylan/eric/ryan/aiden)
#          或角色别名:
#   linhuaiyue (冷面笑匠 → Uncle_Fu) — 一本正经的反差幽默
#   dushe (毒舌主播 → Vivian) — 明快犀利带点小毒舌
#
# --- 预设方案 A: 冷面笑匠 (默认) ---
QWEN_TTS_SPEAKER=linhuaiyue
QWEN_TTS_INSTRUCT=用一本正经的严肃口吻播报新闻，语气越正经越好，语速偏快节奏紧凑
#
# --- 预设方案 B: 毒舌主播 ---
# QWEN_TTS_SPEAKER=dushe
# QWEN_TTS_INSTRUCT=用明快犀利的语气播报新闻，带点小毒舌和俏皮，语速快节奏紧凑
#
QWEN_TTS_LANGUAGE=Chinese
QWEN_TTS_AUTO_RELEASE=true
